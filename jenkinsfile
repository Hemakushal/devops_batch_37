pipeline{
      agent any
           stages{
		stage('fetch the code from Url'){
		    steps{
			git branch: 'master' , url: 'https://github.com/Hemakushal/devops_batch_37.git'
			}
		      }
	        stage('convert the source code to executable code'){
                    steps{
                        build job: 'java_code'
		    }
		  }
                stage('test the code'){
                    steps{
                      echo "this is test code"
		    }
		  }
		stage('Deploy the code'){
                    steps{
                       echo "this code is deployed"
		    }
		  }
	        }
	      }
